  },
  "homepage": "https://github.com/PipulPant/playwright-testmo-reporter#readme",
  "peerDependencies": {
    "@playwright/test": "^1.20.0"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
